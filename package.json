{
	"name": "a11y.cool",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write .",
		"check-types": "turbo run check-types",
		"test:unit": "turbo run test:unit",
		"generate:types": "pnpm --filter @a11y.cool/cms run extract-schema && pnpm --filter @a11y.cool/cms run generate-types",
		"update-deps": "./update-deps.sh",
		"agents:link": "./link-agent-skills.sh"
	},
	"devDependencies": {
		"@a11y.cool/eslint-config": "workspace:*",
		"@a11y.cool/typescript-config": "workspace:*",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"turbo": "^2.11.10",
		"typescript": "6.0.3",
		"@types/node": "^26.6.5"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=22"
	}
}
