{
	"name": "@a11y.cool/data",
	"version": "0.0.1",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"test:unit": "vitest run"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./sanity/*": {
			"types": "./src/sanity/*.ts",
			"import": "./src/sanity/*.ts"
		},
		"./types/*": {
			"types": "./src/types/*.ts",
			"import": "./src/types/*.ts"
		},
		"./seo/*": {
			"types": "./src/seo/*.ts",
			"import": "./src/seo/*.ts"
		}
	},
	"devDependencies": {
		"@a11y.cool/eslint-config": "workspace:*",
		"@a11y.cool/typescript-config": "workspace:*",
		"@portabletext/types": "^4.0.2",
		"@sanity/image-url": "^2.1.1",
		"@sveltejs/kit": "^3.1.0",
		"eslint": "^10.13.0",
		"groq": "^6.20.0",
		"svelte-meta-tags": "^5.0.3",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@sanity/client": "^8.10.1"
	}
}
